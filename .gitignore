# --- Data: snapshots, latents, rollouts, checkpoints (large; not in this repository: regenerate them, or ask the corresponding author) ---
*.npy
*.npz
*.pt
*.pth
*.vtk
*.vtp
*.vtr
*.json

# --- OpenFOAM: keep the case DEFINITION, never the solved fields or generated mesh ---
# generated mesh is regenerated by blockMesh from system/blockMeshDict
01_generate_data/**/constant/polyMesh/
01_generate_data/**/[1-9]*/
01_generate_data/**/0.*/
01_generate_data/**/processor*/
01_generate_data/**/postProcessing/
01_generate_data/**/*.log
01_generate_data/**/log.*
# but DO keep the initial-condition folder "0/" and all of system/ and constant/ dicts
!01_generate_data/**/0/
!01_generate_data/**/0/*

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
*.swp
.idea/
.vscode/
populate_repo.sh

# Generated mesh - regenerate with blockMesh from the dicts in system/
01_generate_data/**/polyMesh/

# Result files that are cited in the paper, tracked as evidence
!03_phase_correction/tangential_transverse.json
!03_phase_correction/stencil_convergence.json
