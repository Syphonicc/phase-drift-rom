FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         90;          // t = 50-90 is used: 1334 snapshots at 0.03

deltaT          0.01;        // smaller than writeInterval so we hit 0.03 cleanly

writeControl    adjustableRunTime;
writeInterval   0.03;        // about 18 snapshots per shedding cycle at Re = 300-800

purgeWrite      0;
writeFormat     ascii;
writePrecision  6;

adjustTimeStep  yes;
maxCo           0.8;

timeFormat      general;
timePrecision   8;

runTimeModifiable false;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        patches         (cylinder);
        writeControl    timeStep;
        writeInterval   1;

        rho             rhoInf;
        rhoInf          1;
        magUInf         1.0;
        lRef            0.12;      // D
        Aref            0.0018;    // D * span = 0.12 * 0.015

        liftDir         (0 1 0);
        dragDir         (1 0 0);
        CofR            (0 0 0);
        pitchAxis       (0 0 1);
    }
}
