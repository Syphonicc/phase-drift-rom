FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         90;

deltaT          0.01;

writeControl    adjustableRunTime;

writeInterval   1000;

purgeWrite      0;

writeFormat     ascii;

writeCompression on;

writePrecision  6;

adjustTimeStep  yes;

maxCo           0.8;

timeFormat      general;

timePrecision   8;

runTimeModifiable false;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            ( "libforces.so" );
        patches         ( cylinder );
        writeControl    timeStep;
        writeInterval   1;
        rho             rhoInf;
        rhoInf          1;
        magUInf         1;
        lRef            0.12;
        Aref            0.0018;
        liftDir         ( 0 1 0 );
        dragDir         ( 1 0 0 );
        CofR            ( 0 0 0 );
        pitchAxis       ( 0 0 1 );
    }
}


